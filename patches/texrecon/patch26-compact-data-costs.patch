diff --git a/libs/tex/calculate_data_costs.cpp b/libs/tex/calculate_data_costs.cpp
index d0f2c0e..38cc44f 100644
--- a/libs/tex/calculate_data_costs.cpp
+++ b/libs/tex/calculate_data_costs.cpp
@@ -29,6 +29,10 @@ typedef acc::BVHTree<unsigned int, math::Vec3f> BVHTree;
 
 TEX_NAMESPACE_BEGIN
 
+static inline Eigen::RowVector3d bb_col(FaceProjectionInfoC const & i) {
+    return Eigen::RowVector3d((double)(float)i.color[0], (double)(float)i.color[1], (double)(float)i.color[2]);
+}
+
 /**
  * Dampens the quality of all views in which the face's projection
  * has a much different color than in the majority of views.
@@ -38,7 +42,7 @@ TEX_NAMESPACE_BEGIN
  * @param settings runtime configuration.
  */
 bool
-photometric_outlier_detection(std::vector<FaceProjectionInfo> * infos, Settings const & settings) {
+photometric_outlier_detection(std::vector<FaceProjectionInfoC> * infos, Settings const & settings) {
     if (infos->size() == 0) return true;
 
     /* Configuration variables. */
@@ -65,7 +69,7 @@ photometric_outlier_detection(std::vector<FaceProjectionInfo> * infos, Settings
     Eigen::MatrixX3d inliers(infos->size(), 3);
     std::vector<std::uint32_t> is_inlier(infos->size(), 1);
     for (std::size_t row = 0; row < infos->size(); ++row) {
-        inliers.row(row) = mve_to_eigen(infos->at(row).mean_color).cast<double>();
+        inliers.row(row) = bb_col(infos->at(row));
     }
 
     Eigen::RowVector3d var_mean;
@@ -102,7 +106,7 @@ photometric_outlier_detection(std::vector<FaceProjectionInfo> * infos, Settings
 
         /* Compute new number of inliers (all views with a gauss value above a threshold). */
         for (std::size_t row = 0; row < infos->size(); ++row) {
-            Eigen::RowVector3d color = mve_to_eigen(infos->at(row).mean_color).cast<double>();
+            Eigen::RowVector3d color = bb_col(infos->at(row));
             double gauss_value = multi_gauss_unnormalized<double, 3>(color, var_mean, covariance_inv);
             is_inlier[row] = (gauss_value >= gauss_rejection_threshold ? 1 : 0);
         }
@@ -110,14 +114,14 @@ photometric_outlier_detection(std::vector<FaceProjectionInfo> * infos, Settings
         inliers.resize(std::accumulate(is_inlier.begin(), is_inlier.end(), 0), Eigen::NoChange);
         for (std::size_t row = 0, inlier_row = 0; row < infos->size(); ++row) {
             if (is_inlier[row]) {
-                inliers.row(inlier_row++) = mve_to_eigen(infos->at(row).mean_color).cast<double>();
+                inliers.row(inlier_row++) = bb_col(infos->at(row));
             }
         }
     }
 
     covariance_inv *= outlier_removal_factor;
-    for (FaceProjectionInfo & info : *infos) {
-        Eigen::RowVector3d color = mve_to_eigen(info.mean_color).cast<double>();
+    for (FaceProjectionInfoC & info : *infos) {
+        Eigen::RowVector3d color = bb_col(info);
         double gauss_value = multi_gauss_unnormalized<double, 3>(color, var_mean, covariance_inv);
         assert(0.0 <= gauss_value && gauss_value <= 1.0);
         switch(settings.outlier_removal) {
@@ -152,7 +156,8 @@ calculate_face_projection_infos(mve::TriangleMesh::ConstPtr mesh,
     ProgressCounter view_counter("\tCalculating face qualities", num_views);
     #pragma omp parallel
     {
-        std::vector<std::pair<std::size_t, FaceProjectionInfo> > projected_face_view_infos;
+        /* bitblade patch26: Puffer je Bild statt je Thread bis zum Schluss (kompakt, 16 Byte) */
+        std::vector<std::pair<std::uint32_t, FaceProjectionInfoC> > projected_face_view_infos;
 
         #pragma omp for schedule(dynamic)
 #if !defined(_MSC_VER)
@@ -280,8 +285,12 @@ calculate_face_projection_infos(mve::TriangleMesh::ConstPtr mesh,
                 /* Change color space. */
                 mve::image::color_rgb_to_ycbcr(*(info.mean_color));
 
-                std::pair<std::size_t, FaceProjectionInfo> pair(face_id, info);
-                projected_face_view_infos.push_back(pair);
+                FaceProjectionInfoC ci;
+                ci.view_id = info.view_id; ci.quality = info.quality;
+                ci.color[0] = (_Float16)info.mean_color[0];
+                ci.color[1] = (_Float16)info.mean_color[1];
+                ci.color[2] = (_Float16)info.mean_color[2];
+                projected_face_view_infos.emplace_back((std::uint32_t)face_id, ci);
             }
 
             texture_view->release_image();
@@ -289,19 +298,16 @@ calculate_face_projection_infos(mve::TriangleMesh::ConstPtr mesh,
             if (settings.data_term == DATA_TERM_GMI) {
                 texture_view->release_gradient_magnitude();
             }
-            view_counter.inc();
-        }
-
-        //std::sort(projected_face_view_infos.begin(), projected_face_view_infos.end());
 
-        #pragma omp critical
-        {
-            for (std::size_t i = projected_face_view_infos.size(); 0 < i; --i) {
-                std::size_t face_id = projected_face_view_infos[i - 1].first;
-                FaceProjectionInfo const & info = projected_face_view_infos[i - 1].second;
-                face_projection_infos->at(face_id).push_back(info);
+            #pragma omp critical(bb_fpi_merge)
+            {
+                for (auto const & e : projected_face_view_infos)
+                    (*face_projection_infos)[e.first].push_back(e.second);
             }
             projected_face_view_infos.clear();
+            if (projected_face_view_infos.capacity() > (std::size_t(1) << 22))
+                std::vector<std::pair<std::uint32_t, FaceProjectionInfoC> >().swap(projected_face_view_infos);
+            view_counter.inc();
         }
     }
 }
@@ -321,12 +327,13 @@ postprocess_face_infos(Settings const & settings,
 #endif
         face_counter.progress<SIMPLE>();
 
-        std::vector<FaceProjectionInfo> & infos = face_projection_infos->at(i);
+        std::vector<FaceProjectionInfoC> & infos = face_projection_infos->at(i);
+        std::sort(infos.begin(), infos.end()); /* bitblade: deterministische Reihenfolge */
         if (settings.outlier_removal != OUTLIER_REMOVAL_NONE) {
             photometric_outlier_detection(&infos, settings);
 
             infos.erase(std::remove_if(infos.begin(), infos.end(),
-                [](FaceProjectionInfo const & info) -> bool {return info.quality == 0.0f;}),
+                [](FaceProjectionInfoC const & info) -> bool {return info.quality == 0.0f;}),
                 infos.end());
         }
         std::sort(infos.begin(), infos.end());
@@ -337,18 +344,18 @@ postprocess_face_infos(Settings const & settings,
     /* Determine the function for the normlization. */
     float max_quality = 0.0f;
     for (std::size_t i = 0; i < face_projection_infos->size(); ++i)
-        for (FaceProjectionInfo const & info : face_projection_infos->at(i))
+        for (FaceProjectionInfoC const & info : face_projection_infos->at(i))
             max_quality = std::max(max_quality, info.quality);
 
     Histogram hist_qualities(0.0f, max_quality, 10000);
     for (std::size_t i = 0; i < face_projection_infos->size(); ++i)
-        for (FaceProjectionInfo const & info : face_projection_infos->at(i))
+        for (FaceProjectionInfoC const & info : face_projection_infos->at(i))
             hist_qualities.add_value(info.quality);
     float percentile = hist_qualities.get_approx_percentile(0.995f);
 
     /* Calculate the costs. */
     for (std::uint32_t i = 0; i < face_projection_infos->size(); ++i) {
-        for (FaceProjectionInfo const & info : face_projection_infos->at(i)) {
+        for (FaceProjectionInfoC const & info : face_projection_infos->at(i)) {
 
             /* Clamp to percentile and normalize. */
             float normalized_quality = std::min(1.0f, info.quality / percentile);
@@ -357,7 +364,7 @@ postprocess_face_infos(Settings const & settings,
         }
 
         /* Ensure that all memory is freeed. */
-        face_projection_infos->at(i) = std::vector<FaceProjectionInfo>();
+        face_projection_infos->at(i) = std::vector<FaceProjectionInfoC>();
     }
 
     std::cout << "\tMaximum quality of a face within an image: " << max_quality << std::endl;
@@ -386,7 +393,7 @@ calculate_data_costs(mve::TriangleMesh::ConstPtr mesh, std::vector<TextureView>
         if (n > 0) {
             std::vector<float> qs; std::size_t cnt = 0;
             for (std::size_t i = 0; i < num_faces; ++i)
-                for (FaceProjectionInfo const & info : face_projection_infos[i])
+                for (FaceProjectionInfoC const & info : face_projection_infos[i])
                     if ((cnt++ % 7) == 0) qs.push_back(info.quality);
             float bb_p = 1.0f;
             if (!qs.empty()) {
@@ -400,10 +407,10 @@ calculate_data_costs(mve::TriangleMesh::ConstPtr mesh, std::vector<TextureView>
             for (std::size_t i = 0; i < num_faces; ++i) {
                 if (!only[i] || face_projection_infos[i].empty()) continue;
                 float mx = 0.0f;
-                for (FaceProjectionInfo const & info : face_projection_infos[i]) mx = std::max(mx, info.quality);
+                for (FaceProjectionInfoC const & info : face_projection_infos[i]) mx = std::max(mx, info.quality);
                 if (mx <= 0.0f) continue;
                 float f = 0.8f * bb_p / mx;
-                for (FaceProjectionInfo & info : face_projection_infos[i]) info.quality *= f;
+                for (FaceProjectionInfoC & info : face_projection_infos[i]) info.quality *= f;
             }
             std::cout << "	bitblade fallback: strict quality percentile " << bb_p << std::endl;
             std::size_t m = 0;
diff --git a/libs/tex/sparse_table.h b/libs/tex/sparse_table.h
index 712773d..ddf8f91 100644
--- a/libs/tex/sparse_table.h
+++ b/libs/tex/sparse_table.h
@@ -34,7 +34,8 @@ class SparseTable {
 
     private:
         std::vector<Column> column_wise_data;
-        std::vector<Row> row_wise_data;
+        std::vector<Row> row_wise_data; /* bitblade patch26: nicht mehr befuellt (ungenutzt) */
+        R num_rows = 0;
 
         std::size_t nnz;
     public:
@@ -48,6 +49,8 @@ class SparseTable {
         Row const & row(R id) const;
 
         void set_value(C col, R row, T value);
+        /* bitblade patch26 */
+        void bb_release_col(C id) { Column().swap(column_wise_data[id]); }
 
         std::size_t get_nnz(void) const;
 
@@ -77,7 +80,7 @@ SparseTable<C, R, T>::cols() const {
 
 template <typename C, typename R, typename T> R
 SparseTable<C, R, T>::rows() const {
-    return row_wise_data.size();
+    return num_rows;
 }
 
 template <typename C, typename R, typename T> typename SparseTable<C, R, T>::Column const &
@@ -98,14 +101,13 @@ SparseTable<C, R, T>::SparseTable() {
 template <typename C, typename R, typename T>
 SparseTable<C, R, T>::SparseTable(C cols, R rows) {
     column_wise_data.resize(cols);
-    row_wise_data.resize(rows);
+    num_rows = rows;
     nnz = 0;
 }
 
 template <typename C, typename R, typename T> void
 SparseTable<C, R, T>::set_value(C col, R row, T value) {
     column_wise_data[col].push_back(std::pair<R, T>(row, value));
-    row_wise_data[row].push_back(std::pair<C, T>(col, value));
     nnz++;
 }
 
diff --git a/libs/tex/texturing.h b/libs/tex/texturing.h
index a266b5b..f7cf264 100644
--- a/libs/tex/texturing.h
+++ b/libs/tex/texturing.h
@@ -35,7 +35,15 @@ typedef ObjModel Model;
 typedef UniGraph Graph;
 typedef SparseTable<std::uint32_t, std::uint16_t, float> DataCosts;
 typedef std::vector<std::vector<VertexProjectionInfo> > VertexProjectionInfos;
-typedef std::vector<std::vector<FaceProjectionInfo> > FaceProjectionInfos;
+/* bitblade patch26: kompakte Kandidaten (12 statt 20 Byte), Farbe als Half-Float */
+struct FaceProjectionInfoC {
+    std::uint16_t view_id;
+    _Float16 color[3];
+    float quality;
+    bool operator<(FaceProjectionInfoC const & o) const { return view_id < o.view_id; }
+};
+static_assert(sizeof(FaceProjectionInfoC) == 12, "FaceProjectionInfoC 12 Byte");
+typedef std::vector<std::vector<FaceProjectionInfoC> > FaceProjectionInfos;
 
 /**
   * prepares the mesh for texturing
diff --git a/libs/tex/view_selection.cpp b/libs/tex/view_selection.cpp
index 4916e08..0851d02 100644
--- a/libs/tex/view_selection.cpp
+++ b/libs/tex/view_selection.cpp
@@ -44,42 +44,33 @@ view_selection(DataCosts const & data_costs, UniGraph * graph, Settings const &)
     mgraph.update_components();
 
     mapmap::LabelSet<cost_t, simd_w> label_set(graph->num_nodes(), false);
-    for (std::size_t i = 0; i < data_costs.cols(); ++i) {
