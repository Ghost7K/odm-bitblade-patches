+
+void
+UniGraph::get_all_subgraphs(
+    std::vector<std::vector<std::vector<std::size_t> > > * subgraphs) const {
+
+    std::vector<bool> used(adj_lists.size(), false);
+
+    for(std::size_t i = 0; i < adj_lists.size(); ++i) {
+        std::size_t const label = labels[i];
+        if (used[i] || label >= subgraphs->size()) continue;
+
+        std::vector<std::vector<std::size_t> > & out = subgraphs->at(label);
+        out.push_back(std::vector<std::size_t>());
+
+        std::list<std::size_t> queue;
+        queue.push_back(i);
+        used[i] = true;
+
+        while (!queue.empty()) {
+            std::size_t node = queue.front();
+            queue.pop_front();
+
+            out.back().push_back(node);
+
+            std::vector<std::size_t> const & adj_list = adj_lists[node];
+            for(std::size_t j = 0; j < adj_list.size(); ++j) {
+                std::size_t adj_node = adj_list[j];
+                if (labels[adj_node] == label && !used[adj_node]){
+                    queue.push_back(adj_node);
+                    used[adj_node] = true;
+                }
+            }
+        }
+    }
+}
