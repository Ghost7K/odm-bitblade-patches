+bool
+TextureAtlas::bb_write_and_release(std::string const & filename) {
+    if (!finalized || bb_written || grayscale || image == nullptr
+        || image->get_type() != mve::IMAGE_TYPE_UINT8) return false;
+    mve::image::save_png_file(std::dynamic_pointer_cast<mve::ByteImage>(image), filename);
+    image.reset();
+    validity_mask.reset();
+    bb_written = true;
+    return true;
+}
