+void
+TexturePatch::compact(bool gamma) {
+    if (image8 || !image) return;
+    int const w = image->width(), h = image->height();
+    mve::ByteImage::Ptr b = mve::ByteImage::create(w, h, 3);
+    float const * src = image->get_data_pointer();
+    uint8_t * dst = b->get_data_pointer();
+    std::size_t const n = static_cast<std::size_t>(w) * h * 3;
+    for (std::size_t i = 0; i < n; ++i) {
+        float f = std::max(0.0f, std::min(1.0f, src[i]));
+        if (gamma) f = std::pow(f, 1.0f / 2.2f);
+        dst[i] = static_cast<uint8_t>(f * 255.0f + 0.5f);
+    }
+    image8 = b;
+    image8_gamma = gamma;
+    image.reset();
+}
+
+mve::FloatImage::ConstPtr
+TexturePatch::float_view(void) const {
+    if (!image8) return image;
+    TexturePatch tmp(*this);
+    tmp.expand();
+    return tmp.image;
+}
+
+void
+TexturePatch::expand(void) {
+    if (!image8) return;
+    int const w = image8->width(), h = image8->height();
+    mve::FloatImage::Ptr f = mve::FloatImage::create(w, h, 3);
+    uint8_t const * src = image8->get_data_pointer();
+    float * dst = f->get_data_pointer();
+    std::size_t const n = static_cast<std::size_t>(w) * h * 3;
+    for (std::size_t i = 0; i < n; ++i) {
+        float v = src[i] / 255.0f;
+        dst[i] = image8_gamma ? std::pow(v, 2.2f) : v;
+    }
+    image = f;
+    image8.reset();
+}
