+#include <fstream>
+/* bitblade Patch 23: Speicherprotokoll je Phase (VmRSS/VmHWM aus /proc/self/status) */
+static void bb_mem(const char* phase) {
+    std::ifstream f("/proc/self/status"); std::string line, rss="?", hwm="?";
+    while (std::getline(f, line)) {
+        if (line.rfind("VmRSS:",0)==0) rss=line.substr(6);
+        if (line.rfind("VmHWM:",0)==0) hwm=line.substr(6);
+    }
+    auto trim=[](std::string x){ x.erase(0,x.find_first_not_of(" \t")); return x; };
+    std::cout << "[bitblade-mem] " << phase << " RSS=" << trim(rss) << " Spitze=" << trim(hwm) << std::endl;
+}
